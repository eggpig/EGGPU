gunrock_legacy_master/
gunrock_legacy_v12_clean/
benchmarking/HyTGraph/

# Raw archives and scratch downloads. Processed small text datasets can be
# versioned deliberately when needed.
datasets/raw_downloads/
datasets/**/*.txt
!datasets/DATASETS.md
!datasets/MANIFEST_*.tsv
!datasets/undirected/LastFM.txt

