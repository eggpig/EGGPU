      "stop": "global sum(abs(new_probability_rank-old_probability_rank)); dangling mass included",
      "threshold": 1e-10,
      "precision": "FP64",
      "sources": [
        {
          "file": {
            "path": "<campaign>/baselines/cggraph_legacy_full_build_v1/source/project/algorithm_host.hpp",
            "sha256": "7e7b085ea2fa463ce369d7ff3236823fee6a9ad82920c42c33e08b80dfb75385"
          },
          "lines": [
            {
              "line": 149,
              "text": "template <typename Graph> count_type UpdateCoprocess(Graph &graph)"
            },
            {
              "line": 150,
              "text": "{"
            },
            {
              "line": 151,
              "text": "    double dangling=0.0, difference=0.0;"
            },
            {
              "line": 152,
              "text": "#pragma omp parallel for reduction(+ : dangling)"
            },
            {
              "line": 153,
              "text": "    for(vertex_id_type v=0;v<graph.vertexNum;++v)"
            },
            {
              "line": 154,
              "text": "        if(graph.outDegree[v]==0) dangling+=graph.vertexValue_in[v];"
            },
            {
              "line": 155,
              "text": "    const double base=(1.0-Alpha+Alpha*dangling)/double(graph.vertexNum);"
            },
            {
              "line": 156,
              "text": "#pragma omp parallel for reduction(+ : difference)"
            },
            {
              "line": 157,
              "text": "    for(vertex_id_type v=0;v<graph.vertexNum;++v){"
            },
            {
              "line": 158,
              "text": "        const double degree=double(graph.outDegree[v]);"
            },
            {
              "line": 159,
              "text": "        const double old_rank=graph.vertexValue_in[v]*(degree>0.0?degree:1.0);"
            },
            {
              "line": 160,
              "text": "        const double rank=base+Alpha*graph.vertexValue_out[v];"
            },
            {
              "line": 161,
              "text": "        difference+=std::abs(rank-old_rank);"
            },
            {
              "line": 162,
              "text": "        graph.vertexValue_out[v]=rank/(degree>0.0?degree:1.0);"
            },
            {
              "line": 163,
              "text": "        graph.vertexValue_in[v]=0.0;"
            },
            {
              "line": 164,
              "text": "    }"
            },
            {
              "line": 165,
              "text": "    // This is full-rank scatter. All source contributions must remain active"
            },
            {
              "line": 166,
              "text": "    // until the common global L1 convergence condition is met."
            },
            {
              "line": 167,
              "text": "    if(difference>1e-10){graph.active.out().fill_smart();return graph.noZeroOutDegreeNum;}"
            },
            {
              "line": 168,
              "text": "    return 0;"
            }
          ]
        },
