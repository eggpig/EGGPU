# Build products
Easy-Graph/build/
Easy-Graph/.eggs/
Easy-Graph/*.egg-info/
Easy-Graph/*.so
EG_Evaluation/build*/
*.so

# Runtime outputs
EG_Evaluation/benchmarking/results/
*.run.log
*.audit.log
*.console.log
*.backend_separation.log
*.non_sota.log

# Conversation/session progress notes are local coordination records, not
# artifact documentation.
EG_Evaluation/EGGPU_SESSION_PROGRESS_*.md

# Python/editor caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
.DS_Store

# Optional third-party baseline checkouts/builds
EG_Evaluation/gunrock_latest/
EG_Evaluation/gunrock_legacy_master/
EG_Evaluation/gunrock_legacy_v12_clean/
EG_Evaluation/benchmarking/HyTGraph/
EG_Evaluation/basic_functions/
EG_Evaluation/cuda_overlays/

# Raw downloads and large generated conversion outputs
EG_Evaluation/datasets/raw_downloads/
EG_Evaluation/datasets_mtx/
EG_Evaluation/paper_sync/

# Keep the public artifact lightweight by default. Full datasets are reproduced
# from EG_Evaluation/datasets/MANIFEST_*.tsv or deliberately force-added.
EG_Evaluation/datasets/**/*.txt
!EG_Evaluation/datasets/DATASETS.md
!EG_Evaluation/datasets/MANIFEST_*.tsv
!EG_Evaluation/datasets/undirected/LastFM.txt
